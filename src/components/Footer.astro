---
import siteData from '../data/site-data.json';
import { localizedPath } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const buildDate = siteData.publishedAtHuman || 'May 31, 2026';
const runLabel = siteData.runLabel || 'Founder-ready MVP';
const contactEmail = 'hello@klearkarma.com';
const calendlyUrl = 'https://calendly.com/klearkarma/30min';

const footerLinks = [
  { label: 'Product', href: '/docs/product/overview' },
  { label: 'Business Model', href: '/docs/founder/business-model' },
  { label: 'Proof Points', href: '/docs/founder/proof-points' },
  { label: 'Artifacts', href: '/docs/research/notebooklm-artifacts' },
];

const partnerLinks = [
  { label: 'Founder Letter', href: '/docs/founder/vision' },
  { label: 'Go-to-Market', href: '/docs/founder/go-to-market' },
  { label: 'Tech Stack', href: '/docs/tech/architecture' },
];
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-grid">
    <div class="footer-brand">
      <strong class="footer-title">{siteData.brandName}</strong>
      <p class="footer-tagline">{siteData.tagline}</p>
      <div class="footer-meta">
        <span>Last updated: {buildDate}</span>
        <span>{runLabel}</span>
      </div>
    </div>

    <div class="footer-nav">
      <h4>Explore</h4>
      <ul>
        {footerLinks.map(link => (
          <li>
            <a href={localizedPath(locale, link.href)}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-nav">
      <h4>For Partners</h4>
      <ul>
        {partnerLinks.map(link => (
          <li>
            <a href={localizedPath(locale, link.href)}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-contact">
      <h4>Contact</h4>
      <a href={`mailto:${contactEmail}`} class="footer-email">{contactEmail}</a>
      <a href={calendlyUrl} class="footer-cta" target="_blank" rel="noopener noreferrer">
        Schedule a 30min call
      </a>
      <p class="footer-note">
        Pre-launch phase. Direct founder access.
      </p>
    </div>
  </div>

  <div class="footer-bottom">
    <small>Everything in this wiki is source-linked and traceable. Nothing is decorative.</small>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding: 3rem clamp(1rem, 4vw, 3rem);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background: linear-gradient(180deg, rgba(9, 7, 17, 0.5), rgba(9, 7, 17, 0.9));
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .footer-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--moon-glass, #D9D2C6);
    display: block;
    margin-bottom: 0.5rem;
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--moon-glass, #D9D2C6);
    opacity: 0.6;
    margin-bottom: 1rem;
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: var(--moon-glass, #D9D2C6);
    opacity: 0.4;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
  }

  .footer-nav h4,
  .footer-contact h4 {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--quiet-gold, #D8B35A);
    margin-bottom: 1rem;
  }

  .footer-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-nav a,
  .footer-email {
    font-size: 0.875rem;
    color: var(--moon-glass, #D9D2C6);
    opacity: 0.7;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .footer-nav a:hover,
  .footer-email:hover {
    opacity: 1;
    color: var(--quiet-gold, #D8B35A);
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-email {
    font-weight: 500;
  }

  .footer-cta {
    display: inline-flex;
    padding: 0.75rem 1.5rem;
    background: var(--quiet-gold, #D8B35A);
    color: var(--mirror-black, #090711);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: all 0.2s ease;
    text-align: center;
  }

  .footer-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(216, 179, 90, 0.25);
  }

  .footer-note {
    font-size: 0.75rem;
    color: var(--moon-glass, #D9D2C6);
    opacity: 0.5;
    margin: 0;
  }

  .footer-bottom {
    max-width: 1400px;
    margin: 2rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    text-align: center;
  }

  .footer-bottom small {
    font-size: 0.75rem;
    color: var(--moon-glass, #D9D2C6);
    opacity: 0.35;
    font-style: italic;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-cta {
      width: 100%;
      justify-content: center;
    }
  }
</style>
