---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ShowcaseGrid from './ShowcaseGrid.astro';
import IngestionFlow from './IngestionFlow.astro';
import siteData from '../data/site-data.json';
import type { Locale } from '../i18n';
import { localizedDocTitle, localizedFeature, localizedPath, t } from '../i18n';
import { hasFrDocs } from '../i18n/fr-docs';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);

// Helper to detect emoji characters
function containsEmoji(str: string): boolean {
  const emojiRegex = /[\u{1F300}-\u{1F9FF}]|[\u{2600}-\u{26FF}]|[\u{2700}-\u{27BF}]/u;
  return emojiRegex.test(str);
}
const docs = await getCollection('docs');
const frDocs = locale === 'fr' && hasFrDocs ? await getCollection('frDocs') : [];
const frDocsBySlug = new Map(frDocs.map((entry) => [entry.slug, entry]));
const localizedDocs = docs.map((doc) => {
  const localized = locale === 'fr' ? frDocsBySlug.get(doc.slug) : undefined;
  return localized
    ? {
        ...doc,
        data: {
          ...doc.data,
          ...localized.data,
        },
      }
    : doc;
});
const docsBySlug = new Map(localizedDocs.map((doc) => [doc.slug, doc]));
const metrics = siteData.metrics || [];
const storyPillars = siteData.storyPillars || [];
const featuredDocs = siteData.featuredDocs || [];
const visualHighlights = siteData.visualHighlights || [];
const notebooklmHighlights = siteData.notebooklmHighlights || [];

const trackItems = featuredDocs.map((doc) => {
  const slug = (doc.href || '').replace(/^\/docs\//, '').replace(/^\//, '');
  const localizedDoc = docsBySlug.get(slug);
  const localized = localizedFeature(locale, doc.href, {
    title: localizedDoc?.data.title || doc.title,
    eyebrow: doc.eyebrow,
    description: localizedDoc?.data.description || doc.description,
  });
  return {
    title: localized.title,
    eyebrow: localized.eyebrow,
    description: localized.description,
    href: localizedPath(locale, doc.href),
    icon: doc.icon,
  };
});

const visualItems = visualHighlights.map((item) => ({
  title: item.title,
  eyebrow: item.eyebrow,
  description: item.description,
  href: localizedPath(locale, item.href),
  image: item.image,
  kind: item.eyebrow,
}));

const artifactItems = notebooklmHighlights.map((item) => ({
  title: item.title,
  eyebrow: item.kind,
  description: item.description,
  href: localizedPath(locale, item.href || siteData.heroSecondaryHref || '/docs/research/notebooklm-artifacts'),
  image: item.image,
  kind: item.kind,
}));

const categories: Record<string, typeof localizedDocs> = {};
for (const doc of localizedDocs) {
  const category = (doc.data.category || 'general').toString();
  if (!categories[category]) categories[category] = [];
  categories[category].push(doc);
}
for (const category of Object.keys(categories)) {
  categories[category].sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
}
const orderedCategories = Object.entries(categories).sort(([a], [b]) => {
  const order = ['general', 'product', 'brand', 'audience', 'marketing'];
  return (order.indexOf(a) === -1 ? 99 : order.indexOf(a)) - (order.indexOf(b) === -1 ? 99 : order.indexOf(b));
});
---

<BaseLayout title={`${siteData.brandName} Immersive Wiki`} description={siteData.heroSubtitle || siteData.tagline} locale={locale}>
  <section class="immersive-home">
    <section class="immersive-hero reveal-in">
      <div class="immersive-hero__copy">
        <p class="eyebrow">{siteData.themeName.toUpperCase()} · {siteData.launchChannel}</p>
        <h1>{siteData.heroTitle}</h1>
        <p class="hero-subtitle">{siteData.heroSubtitle}</p>
        {siteData.heroDescription && <p class="hero-description">{siteData.heroDescription}</p>}
        <div class="hero-actions">
          <a class="cta cta--primary" href={localizedPath(locale, siteData.heroPrimaryHref || '/docs/product/overview')}>{locale === 'fr' ? 'Explorer le récit' : 'Enter the story'}</a>
          <a class="cta cta--secondary" href={localizedPath(locale, siteData.heroSecondaryHref || '/docs/research/notebooklm-artifacts')}>{locale === 'fr' ? 'Ouvrir les artefacts' : 'Open the artifacts'}</a>
        </div>
        {storyPillars.length > 0 && (
          <div class="story-pillars">
            {storyPillars.map((pillar) => <span class="pill pill--soft">{pillar}</span>)}
          </div>
        )}
      </div>

      <div class="immersive-hero__visual glass-panel">
        <div class="immersive-hero__image">
          {siteData.heroImage ? <img src={siteData.heroImage} alt={siteData.heroImageAlt || siteData.brandName} /> : <span>{siteData.brandName}</span>}
        </div>
        <div class="immersive-hero__facts">
          {(siteData.launchFacts || []).map((fact) => (
            <div>
              <small>{fact.label}</small>
              <strong>{fact.value}</strong>
            </div>
          ))}
        </div>
      </div>
    </section>

    {metrics.length > 0 && (
      <section class="immersive-metrics reveal-in">
        {metrics.map((metric) => (
          <div class="glass-panel">
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
          </div>
        ))}
      </section>
    )}

    <IngestionFlow locale={locale} />

    <section class="immersive-section">
      <div class="section-heading reveal-in">
        <p class="eyebrow">{copy.home.curatedLaunchTracks}</p>
        <h2>{copy.home.homeHeading}</h2>
        <p>{copy.home.homeBlurb}</p>
      </div>
      <ShowcaseGrid items={trackItems} variant="docs" />
    </section>

    {visualItems.length > 0 && (
      <section class="immersive-section">
        <div class="section-heading reveal-in">
          <p class="eyebrow">{copy.home.visualWorld}</p>
          <h2>{copy.home.visualHeading}</h2>
        </div>
        <ShowcaseGrid items={visualItems} variant="media" />
      </section>
    )}

    <section class="immersive-section immersive-section--split">
      <div class="immersive-knowledge glass-panel reveal-in">
        <p class="eyebrow">{copy.home.knowledgeMap}</p>
        <h2>{copy.home.knowledgeHeading}</h2>
        <div class="immersive-knowledge__grid">
          {orderedCategories.map(([category, categoryDocs]) => (
            <section>
              <p class="feature-card__eyebrow">{copy.categories[category as keyof typeof copy.categories] || category}</p>
              <ul>
                {categoryDocs.map((doc) => (
                  <li>
                    <a href={localizedPath(locale, `/docs/${doc.slug}`)}>
                      {doc.data.icon && !containsEmoji(doc.data.icon) && <span>{doc.data.icon} </span>}
                      {localizedDocTitle(locale, doc.slug, doc.data.title)}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>

      <div class="immersive-artifacts glass-panel reveal-in">
        <p class="eyebrow">{copy.home.notebooklmSpotlight}</p>
        <h2>{copy.home.notebooklmHeading}</h2>
        <ShowcaseGrid items={artifactItems} variant="artifacts" />
      </div>
    </section>
  </section>
</BaseLayout>
