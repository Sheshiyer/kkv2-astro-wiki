---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from './ScrollReveal.astro';
import siteData from '../data/site-data.json';
import type { Locale } from '../i18n';
import { localizedDocTitle, localizedPath, t } from '../i18n';
import { hasThDocs } from '../i18n/th-docs';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);

const docs = await getCollection('docs');
const thDocs = locale === 'th' && hasThDocs ? await getCollection('thDocs') : [];
const thDocsBySlug = new Map(thDocs.map((entry) => [entry.slug, entry]));
const localizedDocs = docs.map((doc) => {
  const localized = locale === 'th' ? thDocsBySlug.get(doc.slug) : undefined;
  return localized
    ? { ...doc, data: { ...doc.data, ...localized.data } }
    : doc;
});

const categories: Record<string, typeof localizedDocs> = {};
for (const doc of localizedDocs) {
  const category = (doc.data.category || 'general').toString();
  if (!categories[category]) categories[category] = [];
  categories[category].push(doc);
}

const orderedCategories = Object.entries(categories).sort(([a], [b]) => {
  const order = ['product', 'brand', 'audience', 'marketing', 'general'];
  return (order.indexOf(a) === -1 ? 99 : order.indexOf(a)) - (order.indexOf(b) === -1 ? 99 : order.indexOf(b));
});

const featuredDocs = siteData.featuredDocs || [];
const metrics = siteData.metrics || [];
const visualHighlights = siteData.visualHighlights || [];
const notebooklmHighlights = siteData.notebooklmHighlights || [];
const storyPillars = siteData.storyPillars || [];
const launchFacts = siteData.launchFacts || [];
const brandMarkImage = siteData.brandMarkImage || siteData.heroImage;
const mechanismImage = visualHighlights[1]?.image || siteData.heroImage;

const pathCards = [
  {
    title: 'Seekers',
    desc: 'Name what you are carrying before comparing categories, price, or availability.',
    href: '/docs/product/overview',
  },
  {
    title: 'Practitioners',
    desc: 'Receive consent-approved context instead of cold, generic discovery traffic.',
    href: '/docs/product/features',
  },
  {
    title: 'Partners',
    desc: 'Evaluate the token loop, verification layer, and narrow beta economics.',
    href: '/docs/founder/business-model',
  },
  {
    title: 'Builders',
    desc: 'Understand the source-to-wiki pipeline and what still needs to ship.',
    href: '/docs/tech/architecture',
  },
];

const mechanismSteps = [
  {
    label: 'Mirror asks',
    body: 'One primary answer at a time, using reflective language rather than certainty claims.',
  },
  {
    label: 'Mirror maps',
    body: 'The opening flow spends roughly 108 tokens and turns context into a seeker map.',
  },
  {
    label: 'Seeker consents',
    body: 'Only approved context can move toward practitioner support.',
  },
  {
    label: 'Trust compounds',
    body: 'Recharge, repeat token use, handoff quality, and practitioner activation become proof.',
  },
];
---

<BaseLayout 
  title={`${siteData.brandName} — ${siteData.tagline}`} 
  description={siteData.heroSubtitle} 
  locale={locale}
  fullWidth={true}
>
  <div class="immersive-home landing-v2">
    <section class="immersive-hero landing-hero">
      <div class="immersive-hero__copy landing-hero__copy">
        <ScrollReveal>
          <div class="hero-kicker">
            {brandMarkImage && <img src={brandMarkImage} alt="" aria-hidden="true" loading="eager" decoding="async" />}
            <span>{siteData.themeName}</span>
            <span>{siteData.launchChannel}</span>
          </div>
          <h1>{siteData.heroTitle}</h1>
          <p class="hero-lead">{siteData.heroSubtitle}</p>
          {siteData.heroDescription && <p class="hero-desc">{siteData.heroDescription}</p>}

          <div class="hero-actions">
            <a href={localizedPath(locale, siteData.heroPrimaryHref || '/docs/product/overview')} class="btn btn--primary">
              Explore Product
            </a>
            <a href={localizedPath(locale, siteData.heroSecondaryHref || '/docs/research/notebooklm-artifacts')} class="btn btn--secondary">
              View Research
            </a>
            <a href={localizedPath(locale, '/docs/founder/business-model')} class="btn btn--outline">
              For Partners
            </a>
          </div>

          {metrics.length > 0 && (
            <div class="proof-strip" aria-label="Launch proof points">
              {metrics.map((metric) => (
                <div>
                  <strong>{metric.value}</strong>
                  <span>{metric.label}</span>
                </div>
              ))}
            </div>
          )}
        </ScrollReveal>
      </div>

      <div class="immersive-hero__visual landing-hero__visual">
        <ScrollReveal delay={0.08}>
          <div class="hero-product-card glass-panel">
            <div class="hero-product-card__bar">
              <span>Mirror flow</span>
              <span>Consent-safe beta</span>
            </div>
            <img src={siteData.heroImage} alt={siteData.heroImageAlt || 'Klear Karma Mirror flow'} loading="eager" decoding="async" />
            <div class="hero-product-card__caption">
              <strong>Reflection before transaction</strong>
              <span>App-native Mirror, token intent, and practitioner handoff in one controlled loop.</span>
            </div>
          </div>
        </ScrollReveal>
      </div>
    </section>

    {launchFacts.length > 0 && (
      <section class="launch-ledger" aria-label="Launch facts">
        {launchFacts.map((fact, index) => (
          <ScrollReveal delay={index * 0.06}>
            <div class="launch-ledger__item">
              <small>{fact.label}</small>
              <strong>{fact.value}</strong>
            </div>
          </ScrollReveal>
        ))}
      </section>
    )}

    <section class="mechanism-section">
      <ScrollReveal>
        <header class="section-header section-header--left">
          <span class="eyebrow">Mechanism</span>
          <h2>The marketplace is fulfillment. Mirror is the trust layer.</h2>
          <p class="section-lead">Klear Karma replaces category-first browsing with a bounded sequence that helps the seeker articulate context before choosing support.</p>
        </header>
      </ScrollReveal>

      <div class="mechanism-grid">
        <ScrollReveal>
          <figure class="mechanism-media glass-panel">
            <img src={mechanismImage} alt="Klear Karma Mirror interaction surfaces" loading="lazy" decoding="async" />
          </figure>
        </ScrollReveal>
        <div class="mechanism-list">
          {mechanismSteps.map((step, index) => (
            <ScrollReveal delay={index * 0.08}>
              <article class="mechanism-item">
                <span>0{index + 1}</span>
                <div>
                  <h3>{step.label}</h3>
                  <p>{step.body}</p>
                </div>
              </article>
            </ScrollReveal>
          ))}
        </div>
      </div>
    </section>

    <section class="path-entry" aria-label="Choose your path">
      <ScrollReveal>
        <header class="section-header">
          <span class="eyebrow">Entry Points</span>
          <h2>I am here for...</h2>
        </header>
      </ScrollReveal>
      <div class="path-grid">
        {pathCards.map((path, index) => (
          <ScrollReveal delay={index * 0.08}>
            <a href={localizedPath(locale, path.href)} class="path-card">
              <strong>{path.title}</strong>
              <span>{path.desc}</span>
            </a>
          </ScrollReveal>
        ))}
      </div>
    </section>

    {featuredDocs.length > 0 && (
      <section class="immersive-section">
        <ScrollReveal>
          <header class="section-header">
            <span class="eyebrow">Source Docs</span>
            <h2>{copy.home.homeHeading || 'Explore the Portal'}</h2>
            <p class="section-lead">{copy.home.homeBlurb || 'Product documentation, brand guidelines, and research artifacts.'}</p>
          </header>
        </ScrollReveal>
        
        <div class="showcase-grid showcase-grid--docs">
          {featuredDocs.map((doc, index) => (
            <ScrollReveal delay={index * 0.08}>
              <a href={localizedPath(locale, doc.href)} class="immersive-doc-card">
                <span class="immersive-doc-card__index">0{index + 1}</span>
                <span class="immersive-doc-card__icon" aria-hidden="true">↗</span>
                <div class="immersive-doc-card__body">
                  <small>{doc.eyebrow}</small>
                  <strong>{doc.title}</strong>
                  <em>{doc.description}</em>
                </div>
              </a>
            </ScrollReveal>
          ))}
        </div>
      </section>
    )}

    {storyPillars.length > 0 && (
      <section class="immersive-section immersive-section--split">
        <div>
          <ScrollReveal>
            <header class="section-header section-header--left">
              <span class="eyebrow">Principles</span>
              <h2>What the landing page must make obvious</h2>
            </header>
          </ScrollReveal>
          <div class="pillars-list">
            {storyPillars.map((pillar, index) => (
              <ScrollReveal delay={index * 0.1}>
                <div class="pillar-item">
                  <span class="pillar-number">0{index + 1}</span>
                  <p>{pillar}</p>
                </div>
              </ScrollReveal>
            ))}
          </div>
        </div>
        <ScrollReveal delay={0.12}>
          <div class="pillar-visual glass-panel">
            <span class="pillar-visual__text">Mirror<br/>First</span>
          </div>
        </ScrollReveal>
      </section>
    )}

    {visualHighlights.length > 0 && (
      <section class="immersive-section">
        <ScrollReveal>
          <header class="section-header">
            <span class="eyebrow">Visual Library</span>
            <h2>Product and brand assets now driving the page</h2>
            <p class="section-lead">These are hosted source-of-truth assets from the configured Klear Karma R2 bucket.</p>
          </header>
        </ScrollReveal>
        
        <div class="showcase-grid showcase-grid--media">
          {visualHighlights.map((item, index) => (
            <ScrollReveal delay={index * 0.08}>
              <a href={localizedPath(locale, item.href)} class="artifact-card">
                <div class="artifact-card__media">
                  {item.image ? (
                    <img src={item.image} alt={item.title} loading="lazy" decoding="async" />
                  ) : (
                    <span>{item.title}</span>
                  )}
                </div>
                <div class="artifact-card__copy">
                  <p>{item.eyebrow}</p>
                  <h3>{item.title}</h3>
                  <span>{item.description}</span>
                </div>
              </a>
            </ScrollReveal>
          ))}
        </div>
      </section>
    )}

    {notebooklmHighlights.length > 0 && (
      <section class="immersive-section">
        <ScrollReveal>
          <header class="section-header">
            <span class="eyebrow">Research Output</span>
            <h2>NotebookLM Artifacts</h2>
            <p class="section-lead">Reports, infographics, decks, and audio briefs surfaced from the research pipeline.</p>
          </header>
        </ScrollReveal>
        
        <div class="showcase-grid showcase-grid--artifacts">
          {notebooklmHighlights.map((item, index) => (
            <ScrollReveal delay={index * 0.08}>
              <a href={localizedPath(locale, item.href)} class="artifact-card">
                <div class="artifact-card__media">
                  {item.image ? (
                    <img src={item.image} alt={item.title} loading="lazy" decoding="async" />
                  ) : (
                    <span>{item.kind}</span>
                  )}
                </div>
                <div class="artifact-card__copy">
                  <p>{item.kind}</p>
                  <h3>{item.title}</h3>
                  <span>{item.description}</span>
                </div>
              </a>
            </ScrollReveal>
          ))}
        </div>
      </section>
    )}

    {orderedCategories.length > 0 && (
      <section class="immersive-section">
        <ScrollReveal>
          <header class="section-header">
            <span class="eyebrow">Documentation</span>
            <h2>Browse by Category</h2>
          </header>
        </ScrollReveal>
        
        <div class="immersive-knowledge__grid">
          {orderedCategories.map(([category, categoryDocs], catIndex) => (
            <ScrollReveal delay={catIndex * 0.08}>
              <div class="immersive-knowledge glass-panel">
                <h3>
                  {copy.categories[category as keyof typeof copy.categories] || category}
                  <span class="doc-count">{categoryDocs.length}</span>
                </h3>
                <ul>
                  {categoryDocs.slice(0, 6).map((doc) => (
                    <li>
                      <a href={localizedPath(locale, `/docs/${doc.slug}`)}>
                        {localizedDocTitle(locale, doc.slug, doc.data.title)}
                      </a>
                    </li>
                  ))}
                  {categoryDocs.length > 6 && (
                    <li class="more-link">
                      <a href={localizedPath(locale, `/docs/${categoryDocs[0].slug}`)}>
                        +{categoryDocs.length - 6} more
                      </a>
                    </li>
                  )}
                </ul>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </section>
    )}

    <section class="immersive-section cta-final">
      <ScrollReveal>
        <div class="cta-final__content glass-panel">
          <span class="eyebrow">Founder-ready MVP build</span>
          <h2>Ready to inspect the trust layer?</h2>
          <p>Start with the product overview, then review the source artifacts behind the landing page.</p>
          <div class="cta-final__actions">
            <a href={localizedPath(locale, '/docs/product/overview')} class="btn btn--primary">
              Product Overview
            </a>
            <a href={localizedPath(locale, '/docs/research/notebooklm-artifacts')} class="btn btn--secondary">
              Research Artifacts
            </a>
          </div>
        </div>
      </ScrollReveal>
    </section>
  </div>
</BaseLayout>
