---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from './ScrollReveal.astro';
import siteData from '../data/site-data.json';
import type { Locale } from '../i18n';
import { localizedDocTitle, localizedPath, t } from '../i18n';
import { hasThDocs } from '../i18n/th-docs';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);

const docs = await getCollection('docs');
const thDocs = locale === 'th' && hasThDocs ? await getCollection('thDocs') : [];
const thDocsBySlug = new Map(thDocs.map((entry) => [entry.slug, entry]));
const localizedDocs = docs.map((doc) => {
  const localized = locale === 'th' ? thDocsBySlug.get(doc.slug) : undefined;
  return localized
    ? { ...doc, data: { ...doc.data, ...localized.data } }
    : doc;
});

const categories: Record<string, typeof localizedDocs> = {};
for (const doc of localizedDocs) {
  const category = (doc.data.category || 'general').toString();
  if (!categories[category]) categories[category] = [];
  categories[category].push(doc);
}

const orderedCategories = Object.entries(categories).sort(([a], [b]) => {
  const order = ['product', 'brand', 'audience', 'marketing', 'general'];
  return (order.indexOf(a) === -1 ? 99 : order.indexOf(a)) - (order.indexOf(b) === -1 ? 99 : order.indexOf(b));
});

const featuredDocs = siteData.featuredDocs || [];
const metrics = siteData.metrics || [];
const visualHighlights = siteData.visualHighlights || [];
const notebooklmHighlights = siteData.notebooklmHighlights || [];
const storyPillars = siteData.storyPillars || [];
const launchFacts = siteData.launchFacts || [];
---

<BaseLayout 
  title={`${siteData.brandName} — ${siteData.tagline}`} 
  description={siteData.heroSubtitle} 
  locale={locale}
  fullWidth={true}
>
  <div class="immersive-home">
    <!-- Hero Section -->
    <section class="immersive-hero">
      <div class="immersive-hero__copy">
        <ScrollReveal>
          <span class="hero-eyebrow">{siteData.themeName}</span>
          <h1>{siteData.heroTitle}</h1>
          <p class="hero-lead">{siteData.heroSubtitle}</p>
          {siteData.heroDescription && <p class="hero-desc">{siteData.heroDescription}</p>}
          <div class="hero-actions">
            <a href={localizedPath(locale, siteData.heroPrimaryHref || '/docs/product/overview')} class="btn btn--primary">
              {locale === 'th' ? 'สำรวจผลิตภัณฑ์' : 'Explore Product'}
            </a>
            <a href={localizedPath(locale, siteData.heroSecondaryHref || '/docs/research/notebooklm-artifacts')} class="btn btn--secondary">
              {locale === 'th' ? 'ดูงานวิจัย' : 'View Artifacts'}
            </a>
          </div>
          
          {launchFacts.length > 0 && (
            <div class="immersive-hero__facts">
              {launchFacts.map((fact) => (
                <div class="glass-panel">
                  <small>{fact.label}</small>
                  <strong>{fact.value}</strong>
                </div>
              ))}
            </div>
          )}
        </ScrollReveal>
      </div>
      
      <div class="immersive-hero__visual">
        <div class="immersive-hero__image">
          <span>Reflective<br/>Trust<br/>Field</span>
        </div>
      </div>
    </section>

    <!-- Metrics Section -->
    {metrics.length > 0 && (
      <section class="immersive-section">
        <ScrollReveal>
          <header class="section-header">
            <span class="eyebrow">Launch Metrics</span>
            <h2>Wave 7 Output Summary</h2>
          </header>
        </ScrollReveal>
        <div class="immersive-metrics">
          {metrics.map((metric, index) => (
            <ScrollReveal delay={index * 0.1}>
              <div class="glass-panel metric-card" data-count={metric.value}>
                <strong class="metric-value">0</strong>
                <span>{metric.label}</span>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </section>
    )}

    <!-- Featured Documents -->
    {featuredDocs.length > 0 && (
      <section class="immersive-section">
        <ScrollReveal>
          <header class="section-header">
            <span class="eyebrow">Featured</span>
            <h2>{copy.home.homeHeading || 'Explore the Portal'}</h2>
            <p class="section-lead">{copy.home.homeBlurb || 'Product documentation, brand guidelines, and research artifacts.'}</p>
          </header>
        </ScrollReveal>
        
        <div class="showcase-grid showcase-grid--docs">
          {featuredDocs.map((doc, index) => (
            <ScrollReveal delay={index * 0.1}>
              <a href={localizedPath(locale, doc.href)} class="immersive-doc-card">
                <span class="immersive-doc-card__index">0{index + 1}</span>
                <span class="immersive-doc-card__icon">→</span>
                <div class="immersive-doc-card__body">
                  <small>{doc.eyebrow}</small>
                  <strong>{doc.title}</strong>
                  <em>{doc.description}</em>
                </div>
              </a>
            </ScrollReveal>
          ))}
        </div>
      </section>
    )}

    <!-- Story Pillars -->
    {storyPillars.length > 0 && (
      <section class="immersive-section immersive-section--split">
        <div>
          <ScrollReveal>
            <header class="section-header section-header--left">
              <span class="eyebrow">Principles</span>
              <h2>Core Narrative Pillars</h2>
            </header>
          </ScrollReveal>
          <div class="pillars-list">
            {storyPillars.map((pillar, index) => (
              <ScrollReveal delay={index * 0.15}>
                <div class="pillar-item">
                  <span class="pillar-number">0{index + 1}</span>
                  <p>{pillar}</p>
                </div>
              </ScrollReveal>
            ))}
          </div>
        </div>
        <div class="pillar-visual glass-panel">
          <span class="pillar-visual__text">Mirror<br/>First</span>
        </div>
      </section>
    )}

    <!-- Visual Highlights -->
    {visualHighlights.length > 0 && (
      <section class="immersive-section">
        <ScrollReveal>
          <header class="section-header">
            <span class="eyebrow">Visual Library</span>
            <h2>NotebookLM Visual Assets</h2>
            <p class="section-lead">Generated artifacts from the research pipeline</p>
          </header>
        </ScrollReveal>
        
        <div class="showcase-grid showcase-grid--media">
          {visualHighlights.map((item, index) => (
            <ScrollReveal delay={index * 0.1}>
              <a href={localizedPath(locale, item.href)} class="artifact-card">
                <div class="artifact-card__media">
                  {item.image ? (
                    <img src={item.image} alt={item.title} loading="lazy" />
                  ) : (
                    <span>{item.title}</span>
                  )}
                </div>
                <div class="artifact-card__copy">
                  <p>{item.eyebrow}</p>
                  <h3>{item.title}</h3>
                  <span>{item.description}</span>
                </div>
              </a>
            </ScrollReveal>
          ))}
        </div>
      </section>
    )}

    <!-- NotebookLM Artifacts -->
    {notebooklmHighlights.length > 0 && (
      <section class="immersive-section">
        <ScrollReveal>
          <header class="section-header">
            <span class="eyebrow">Research Output</span>
            <h2>NotebookLM Artifacts</h2>
            <p class="section-lead">Reports, infographics, decks, and audio briefs</p>
          </header>
        </ScrollReveal>
        
        <div class="showcase-grid showcase-grid--artifacts">
          {notebooklmHighlights.map((item, index) => (
            <ScrollReveal delay={index * 0.1}>
              <a href={localizedPath(locale, item.href)} class="artifact-card">
                <div class="artifact-card__media">
                  {item.image ? (
                    <img src={item.image} alt={item.title} loading="lazy" />
                  ) : (
                    <span>{item.kind}</span>
                  )}
                </div>
                <div class="artifact-card__copy">
                  <p>{item.kind}</p>
                  <h3>{item.title}</h3>
                  <span>{item.description}</span>
                </div>
              </a>
            </ScrollReveal>
          ))}
        </div>
      </section>
    )}

    <!-- Knowledge Map -->
    {orderedCategories.length > 0 && (
      <section class="immersive-section">
        <ScrollReveal>
          <header class="section-header">
            <span class="eyebrow">Documentation</span>
            <h2>Browse by Category</h2>
          </header>
        </ScrollReveal>
        
        <div class="immersive-knowledge__grid">
          {orderedCategories.map(([category, categoryDocs], catIndex) => (
            <ScrollReveal delay={catIndex * 0.1}>
              <div class="immersive-knowledge glass-panel">
                <h3>
                  {copy.categories[category as keyof typeof copy.categories] || category}
                  <span class="doc-count">{categoryDocs.length}</span>
                </h3>
                <ul>
                  {categoryDocs.slice(0, 6).map((doc) => (
                    <li>
                      <a href={localizedPath(locale, `/docs/${doc.slug}`)}>
                        {localizedDocTitle(locale, doc.slug, doc.data.title)}
                      </a>
                    </li>
                  ))}
                  {categoryDocs.length > 6 && (
                    <li class="more-link">
                      <a href={localizedPath(locale, `/docs/${categoryDocs[0].slug}`)}>
                        +{categoryDocs.length - 6} more
                      </a>
                    </li>
                  )}
                </ul>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </section>
    )}

    <!-- CTA Section -->
    <section class="immersive-section cta-final">
      <ScrollReveal>
        <div class="cta-final__content glass-panel">
          <h2>Ready to explore?</h2>
          <p>Start with the product overview or dive into the research artifacts.</p>
          <div class="cta-final__actions">
            <a href={localizedPath(locale, '/docs/product/overview')} class="btn btn--primary">
              {locale === 'th' ? 'เริ่มต้น' : 'Get Started'}
            </a>
            <a href={localizedPath(locale, '/docs/research/notebooklm-artifacts')} class="btn btn--secondary">
              {locale === 'th' ? 'ดูงานวิจัย' : 'View Artifacts'}
            </a>
          </div>
        </div>
      </ScrollReveal>
    </section>
  </div>

  <script>
    // Animated counters
    const animateCounters = () => {
      const counters = document.querySelectorAll('.metric-card[data-count]');
      counters.forEach(counter => {
        const target = parseInt(counter.getAttribute('data-count') || '0');
        const valueEl = counter.querySelector('.metric-value');
        if (!valueEl) return;
        
        let current = 0;
        const increment = target / 60;
        const updateCounter = () => {
          if (current < target) {
            current += increment;
            valueEl.textContent = Math.ceil(current).toString();
            requestAnimationFrame(updateCounter);
          } else {
            valueEl.textContent = target.toString();
          }
        };
        
        // Use IntersectionObserver to trigger when visible
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              updateCounter();
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.5 });
        
        observer.observe(counter);
      });
    };

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', animateCounters);
    } else {
      animateCounters();
    }
  </script>
</BaseLayout>

<style>
  /* Override immersive-home for full-width */
  .immersive-home {
    display: grid;
    gap: clamp(3rem, 8vw, 8rem);
    padding: 0 clamp(1rem, 3vw, 3rem);
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Hero overrides */
  .immersive-hero {
    min-height: calc(100vh - 6rem);
    margin-top: -1rem;
    padding-top: 2rem;
  }

  .hero-eyebrow {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--quiet-gold, #D8B35A);
    margin-bottom: 1.5rem;
  }

  .hero-lead {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    color: var(--moon-glass, #D9D2C6);
    line-height: 1.5;
    max-width: 50ch;
    margin-bottom: 1.5rem;
  }

  .hero-desc {
    font-size: 1rem;
    color: var(--moon-glass, #D9D2C6);
    opacity: 0.7;
    max-width: 55ch;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    border-radius: 0.5rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    border: 2px solid transparent;
    font-size: 0.9375rem;
  }

  .btn--primary {
    background: var(--quiet-gold, #D8B35A);
    color: var(--mirror-black, #090711);
  }

  .btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(216, 179, 90, 0.3);
  }

  .btn--secondary {
    background: transparent;
    color: var(--moon-glass, #D9D2C6);
    border-color: rgba(217, 210, 198, 0.3);
  }

  .btn--secondary:hover {
    background: rgba(217, 210, 198, 0.1);
    border-color: var(--moon-glass, #D9D2C6);
  }

  /* Sections */
  .immersive-section {
    padding: 2rem 0;
  }

  /* Section headers */
  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header--left {
    text-align: left;
  }

  .eyebrow {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--quiet-gold, #D8B35A);
    margin-bottom: 1rem;
  }

  .section-header h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }

  .section-lead {
    color: var(--moon-glass, #D9D2C6);
    opacity: 0.7;
    font-size: 1.125rem;
    max-width: 50ch;
    margin: 0 auto;
  }

  /* Metrics */
  .metric-card {
    text-align: center;
    padding: 2rem !important;
  }

  .metric-value {
    font-size: clamp(2.5rem, 5vw, 3.5rem) !important;
    color: var(--quiet-gold, #D8B35A);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  /* Pillars */
  .pillars-list {
    display: grid;
    gap: 1.5rem;
  }

  .pillar-item {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    transition: all 0.3s ease;
  }

  .pillar-item:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(216, 179, 90, 0.2);
    transform: translateX(8px);
  }

  .pillar-number {
    font-size: 2rem;
    font-weight: 700;
    color: var(--quiet-gold, #D8B35A);
    opacity: 0.5;
    line-height: 1;
    font-family: var(--font-mono, monospace);
  }

  .pillar-item p {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--moon-glass, #D9D2C6);
  }

  .pillar-visual {
    display: grid;
    place-items: center;
    min-height: 300px;
    background: linear-gradient(135deg, rgba(34, 18, 69, 0.6), rgba(9, 7, 17, 0.8));
  }

  .pillar-visual__text {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    text-align: center;
    line-height: 1.1;
    background: linear-gradient(135deg, var(--quiet-gold, #D8B35A), var(--moon-glass, #D9D2C6));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Knowledge map */
  .immersive-knowledge h3 {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1.25rem;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .doc-count {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--quiet-gold, #D8B35A);
    background: rgba(216, 179, 90, 0.1);
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
  }

  .immersive-knowledge a {
    color: var(--moon-glass, #D9D2C6);
    text-decoration: none;
    opacity: 0.8;
    transition: all 0.2s ease;
    display: block;
    padding: 0.35rem 0;
  }

  .immersive-knowledge a:hover {
    opacity: 1;
    color: var(--quiet-gold, #D8B35A);
    transform: translateX(4px);
  }

  .more-link a {
    color: var(--quiet-gold, #D8B35A);
    font-weight: 600;
    opacity: 1;
  }

  /* CTA Final */
  .cta-final {
    padding-bottom: 4rem;
  }

  .cta-final__content {
    text-align: center;
    padding: 4rem 2rem !important;
    max-width: 700px;
    margin: 0 auto;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02)) !important;
  }

  .cta-final__content h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1rem;
  }

  .cta-final__content p {
    color: var(--moon-glass, #D9D2C6);
    opacity: 0.8;
    margin-bottom: 2rem;
    font-size: 1.125rem;
  }

  .cta-final__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Card visibility overrides - make them pop */
  .immersive-doc-card {
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.04)) !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    padding: 1.5rem !important;
  }

  .immersive-doc-card:hover {
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.06)) !important;
    border-color: rgba(216, 179, 90, 0.3) !important;
    transform: translateY(-4px);
  }

  .artifact-card {
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.04)) !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
  }

  .artifact-card:hover {
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.06)) !important;
    border-color: rgba(216, 179, 90, 0.3) !important;
    transform: translateY(-4px);
  }

  .artifact-card__media {
    background: rgba(34, 18, 69, 0.5) !important;
    min-height: 160px;
    display: grid;
    place-items: center;
  }

  .artifact-card__media span {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--quiet-gold, #D8B35A);
  }

  .artifact-card__media img {
    width: 100%;
    height: 160px;
    object-fit: cover;
  }

  /* Responsive */
  @media (max-width: 1180px) {
    .immersive-hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .immersive-hero__visual {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .immersive-metrics {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero-actions,
    .cta-final__actions {
      flex-direction: column;
    }

    .btn {
      width: 100%;
      justify-content: center;
    }

    .pillar-item {
      flex-direction: column;
      gap: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pillar-item:hover {
      transform: none;
    }

    .immersive-knowledge a:hover {
      transform: none;
    }
  }
</style>
