---
import siteData from '../data/site-data.json';
import type { Locale } from '../i18n';
import { localizedPath } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const allDocs = [
  { title: 'Product Overview', href: '/docs/product/overview', category: 'Product' },
  { title: 'Product Features', href: '/docs/product/features', category: 'Product' },
  { title: 'Product Specifications', href: '/docs/product/specifications', category: 'Product' },
  { title: 'Founder Letter', href: '/docs/founder/vision', category: 'Founder' },
  { title: 'Business Model', href: '/docs/founder/business-model', category: 'Founder' },
  { title: 'Go-to-Market', href: '/docs/founder/go-to-market', category: 'Founder' },
  { title: 'Proof Points', href: '/docs/founder/proof-points', category: 'Founder' },
  { title: 'Visual Guidelines', href: '/docs/brand/visual-guidelines', category: 'Brand' },
  { title: 'Voice & Tone', href: '/docs/brand/voice-tone', category: 'Brand' },
  { title: 'Visual Assets', href: '/docs/brand/visual-assets', category: 'Brand' },
  { title: 'Primary Persona', href: '/docs/audience/primary-persona', category: 'Audience' },
  { title: 'Secondary Personas', href: '/docs/audience/secondary-personas', category: 'Audience' },
  { title: 'Competitive Landscape', href: '/docs/market/competitive-landscape', category: 'Audience' },
  { title: 'Campaign Copy', href: '/docs/marketing/campaign-copy', category: 'Marketing' },
  { title: 'Email Templates', href: '/docs/marketing/email-templates', category: 'Marketing' },
  { title: 'Social Content', href: '/docs/marketing/social-content', category: 'Marketing' },
  { title: 'Video Scripts', href: '/docs/marketing/video-scripts', category: 'Marketing' },
  { title: 'Ad Creative', href: '/docs/marketing/ad-creative', category: 'Marketing' },
  { title: 'Brand Intelligence Report', href: '/docs/research/report-briefing', category: 'Research' },
  { title: 'Study Guide', href: '/docs/research/report-study-guide', category: 'Research' },
  { title: 'NotebookLM Artifacts', href: '/docs/research/notebooklm-artifacts', category: 'Research' },
  { title: 'Technical Architecture', href: '/docs/tech/architecture', category: 'Tech' },
];

const artifacts = siteData.notebooklmHighlights || [];
---

<div class="site-search" id="site-search">
  <input
    type="search"
    id="search-input"
    class="search-input"
    placeholder="Search docs, artifacts, and pages..."
    aria-label="Search site"
    autocomplete="off"
  />
  <div class="search-results" id="search-results" hidden></div>
</div>

<script define:vars={{ docs: allDocs, artifactItems: artifacts }}>
  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');

  function search(query) {
    if (!query || query.length < 2) return [];
    const q = query.toLowerCase();

    const docHits = docs
      .filter(d => d.title.toLowerCase().includes(q) || d.category.toLowerCase().includes(q))
      .map(d => ({ ...d, type: 'Doc' }));

    const artHits = artifactItems
      .filter(a => a.title.toLowerCase().includes(q) || a.kind.toLowerCase().includes(q))
      .map(a => ({ title: a.title, href: a.href, category: a.kind, type: 'Artifact' }));

    return [...docHits, ...artHits].slice(0, 8);
  }

  function render(hits) {
    if (!hits.length) {
      results.innerHTML = '<div class="search-empty">No results found</div>';
      results.hidden = false;
      return;
    }

    results.innerHTML = hits.map(h => `
      <a href="${h.href}" class="search-result">
        <span class="search-result__type">${h.type}</span>
        <span class="search-result__title">${h.title}</span>
        <span class="search-result__cat">${h.category}</span>
      </a>
    `).join('');
    results.hidden = false;
  }

  input?.addEventListener('input', (e) => {
    const hits = search(e.target.value.trim());
    render(hits);
  });

  input?.addEventListener('focus', (e) => {
    if (e.target.value.trim().length >= 2) {
      render(search(e.target.value.trim()));
    }
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('#site-search')) {
      results.hidden = true;
    }
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      results.hidden = true;
      input.blur();
    }
  });
</script>

<style>
  .site-search {
    position: relative;
    max-width: 480px;
    width: 100%;
  }

  .search-input {
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.5rem;
    color: var(--moon-glass, #D9D2C6);
    font-size: 0.875rem;
    font-family: var(--font-body, 'Inter', sans-serif);
    outline: none;
    transition: all 0.2s ease;
  }

  .search-input::placeholder {
    color: var(--moon-glass, #D9D2C6);
    opacity: 0.4;
  }

  .search-input:focus {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--quiet-gold, #D8B35A);
    box-shadow: 0 0 0 3px rgba(216, 179, 90, 0.1);
  }

  .search-results {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    background: var(--mirror-black, #090711);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    padding: 0.5rem;
    z-index: 100;
    max-height: 320px;
    overflow-y: auto;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }

  .search-result {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.375rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.15s ease;
  }

  .search-result:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .search-result__type {
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--quiet-gold, #D8B35A);
    background: rgba(216, 179, 90, 0.1);
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    white-space: nowrap;
  }

  .search-result__title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--moon-glass, #D9D2C6);
    flex: 1;
  }

  .search-result__cat {
    font-size: 0.75rem;
    color: var(--moon-glass, #D9D2C6);
    opacity: 0.5;
    white-space: nowrap;
  }

  .search-empty {
    padding: 1rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--moon-glass, #D9D2C6);
    opacity: 0.5;
  }
</style>
