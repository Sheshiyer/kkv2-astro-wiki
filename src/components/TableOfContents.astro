---
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  headings: { depth: number; slug: string; text: string }[];
  locale: Locale;
}

const { headings, locale } = Astro.props;
const copy = t(locale);
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

{toc.length > 0 && (
  <aside class="toc-panel glass-panel">
    <p class="eyebrow">{copy.shell.onThisPage}</p>
    <ul class="toc-list">
      {toc.map((heading) => (
        <li class:list={['toc-item', `toc-item--${heading.depth}`]}>
          <a href={`#${heading.slug}`} class="toc-link">{heading.text}</a>
        </li>
      ))}
    </ul>
  </aside>
)}

<script is:inline>
  const tocLinks = document.querySelectorAll('.toc-link');
  const headings = document.querySelectorAll('h2[id], h3[id]');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        tocLinks.forEach((link) => link.classList.remove('is-active'));
        const activeLink = document.querySelector(`.toc-link[href="#${entry.target.id}"]`);
        activeLink?.classList.add('is-active');
      }
    });
  }, { rootMargin: '-25% 0px -60% 0px' });

  headings.forEach((heading) => observer.observe(heading));
</script>

<style>
  .toc-panel {
    border-radius: var(--radius-xl);
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.08),
      rgba(255, 255, 255, 0.025)
    );
    border: 1px solid var(--surface-border);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(24px) saturate(135%);
    padding: clamp(1rem, 1.5vw, 1.5rem);
  }

  [data-theme='dark'] .toc-panel {
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.06),
      rgba(255, 255, 255, 0.02)
    );
    border-color: rgba(255, 255, 255, 0.08);
  }

  .eyebrow {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-soft);
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--surface-border);
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .toc-item {
    margin: 0;
  }

  .toc-link {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: all 180ms ease;
    border-left: 2px solid transparent;
  }

  .toc-link:hover {
    color: var(--text-strong);
    background: rgba(255, 255, 255, 0.05);
    border-left-color: var(--surface-border);
  }

  .toc-link.is-active {
    color: var(--brand-accent);
    background: color-mix(in srgb, var(--brand-accent) 8%, transparent);
    border-left-color: var(--brand-accent);
    font-weight: 600;
  }

  .toc-item--3 .toc-link {
    padding-left: var(--space-6);
    font-size: 0.78rem;
  }

  @media (max-width: 768px) {
    .toc-panel {
      padding: var(--space-3);
      border-radius: var(--radius-lg);
    }

    .toc-link {
      padding: var(--space-2);
      font-size: 0.78rem;
    }
  }
</style>
