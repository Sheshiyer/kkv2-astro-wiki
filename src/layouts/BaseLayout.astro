---
import Navigation from '../components/Navigation.astro';
import PageTransitionController from '../components/PageTransitionController.astro';
import PixelMediaLayer from '../components/PixelMediaLayer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import WebGLBackground from '../components/WebGLBackground.astro';
import siteData from '../data/site-data.json';
import type { Locale } from '../i18n';
import { localizedPath } from '../i18n';
import '../styles/global.css';
import '../styles/immersive.css';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  fullWidth?: boolean;
}

const { title, description, locale, fullWidth = false } = Astro.props;
const palette = siteData.palette || {};
---

<!DOCTYPE html>
<html lang={locale} data-theme={siteData.defaultTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content={palette.primary?.hex || '#17131f'}>
  </head>
  <body class={`immersive-body ${fullWidth ? 'immersive-body--fullwidth' : ''}`}>
    <WebGLBackground />
    <div class="immersive-shell">
      <header class="immersive-topbar glass-panel">
        <a href={localizedPath(locale, '/')} class="brand-lockup">
          <img src="/logo.png" alt="Logo" width="32" height="32">
          <span class="brand-text">
            <strong>{siteData.brandName}</strong>
            <small>{siteData.tagline}</small>
          </span>
        </a>

        <button class="hamburger" id="menu-toggle">
          <span class="line"></span>
        </button>

        <nav class="immersive-topbar__links">
          <a href={localizedPath(locale, '/')}>Portal</a>
          <a href={localizedPath(locale, siteData.docsHomeHref)}>Docs</a>
          <a href={localizedPath(locale, siteData.heroSecondaryHref || '/docs/research/notebooklm-artifacts')}">NotebookLM</a>
        </nav>
      </header>

      {!fullWidth && (
        <aside class="immersive-sidebar" id="sidebar">
          <Navigation locale={locale} />
        </aside>
      )}

      <main class="immersive-content">
        <slot />
      </main>
    </div>

    <ThemeToggle locale={locale} />

    <script>
      const menuToggle = document.getElementById('menu-toggle');
      const sidebar = document.getElementById('sidebar');
      const body = document.body;

      menuToggle?.addEventListener('click', () => {
        body.classList.toggle('sidebar-open');
      });

      // Close on link click
      sidebar?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => document.body.classList.remove('sidebar-open'));
      });
    </script>

    <style>
      .immersive-body {
        min-height: 100vh;
      }
      
      .hamburger {
        display: none;
        appearance: none;
        background: none;
        border: none;
        padding: 0.5rem;
        cursor: pointer;
      }

      .hamburger span {
        display: block;
        width: 1.5rem;
        height: 2px;
        background: currentColor;
        margin-block: 4px;
      }

      @media (max-width: 768px) {
        .immersive-sidebar {
          position: fixed;
          left: -100%;
          width: 280px;
          transform: translateX(0);
          height: 100vh;
          transition: left 0.3s;
          z-index: 1000;
        }
        body.sidebar-open { overflow: hidden; }
        .sidebar-open .immersive-sidebar {
          left: 0;
        }
      }
    </style>
  </body>
</html>
