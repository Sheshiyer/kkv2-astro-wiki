---
import BaseLayout from './BaseLayout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import DocContentAnimator from '../components/DocContentAnimator.astro';
import ArtifactDetail from '../components/ArtifactDetail.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  title: string;
  description?: string;
  category?: string;
  headings?: { depth: number; slug: string; text: string }[];
  locale: Locale;
}

const { title, description, category, headings = [], locale } = Astro.props;
const copy = t(locale);
const content = await Astro.slots.render('default');
const wordCount = content.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 210));
---

<BaseLayout title={title} description={description} locale={locale}>
  <section class="immersive-doc-stage">
    <div class="immersive-doc-hero reveal-in">
      <Breadcrumb title={title} category={category} locale={locale} />
      <div class="doc-header__meta">
        {category && <span class="pill pill--soft">{category}</span>}
        <span class="pill pill--warm">{readingTime} {copy.shell.minRead}</span>
      </div>
      <h1>{title}</h1>
      {description && <p class="doc-description">{description}</p>}
    </div>

    <div class="immersive-doc-grid">
      <article class="immersive-doc-panel glass-panel">
        <DocContentAnimator>
          <div class="prose portal-prose doc-prose">
            <slot />
          </div>
        </DocContentAnimator>
      </article>

      <ScrollReveal delay={0.2}>
        <div class="immersive-doc-rail">
          <ArtifactDetail title={title} description={description} category={category} readingTime={readingTime} headings={headings} />
          {headings.length > 0 && <TableOfContents headings={headings} locale={locale} />}
        </div>
      </ScrollReveal>
    </div>
  </section>
</BaseLayout>

<style>
  /* Doc Layout Overrides - Premium Styling */
  .immersive-doc-panel {
    border-radius: var(--radius-xl);
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.08),
      rgba(255, 255, 255, 0.025)
    );
    border: 1px solid var(--surface-border);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(24px) saturate(135%);
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }

  [data-theme='dark'] .immersive-doc-panel {
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.06),
      rgba(255, 255, 255, 0.02)
    );
    border-color: rgba(255, 255, 255, 0.08);
  }

  /* Prose Content Styling */
  .doc-prose {
    font-size: 1.05rem;
    line-height: 1.75;
  }

  /* Headings */
  .doc-prose h1 {
    font-size: 2.2em;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: var(--space-4);
    color: var(--text-strong);
    letter-spacing: -0.02em;
  }

  .doc-prose h2 {
    font-size: 1.6em;
    font-weight: 700;
    line-height: 1.2;
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    color: var(--text-strong);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--surface-border);
    letter-spacing: -0.01em;
  }

  .doc-prose h3 {
    font-size: 1.25em;
    font-weight: 600;
    line-height: 1.3;
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
    color: var(--text-strong);
  }

  .doc-prose h4 {
    font-size: 1.1em;
    font-weight: 600;
    line-height: 1.4;
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    color: var(--text-strong);
  }

  /* Paragraphs */
  .doc-prose p {
    margin-bottom: var(--space-4);
    color: var(--text-body);
    max-width: 70ch;
  }

  .doc-prose p:first-of-type {
    font-size: 1.1rem;
    color: var(--text-strong);
  }

  /* Lists */
  .doc-prose ul,
  .doc-prose ol {
    margin-bottom: var(--space-5);
    padding-left: 1.5rem;
  }

  .doc-prose li {
    margin-bottom: var(--space-2);
    padding-left: var(--space-2);
    color: var(--text-body);
    line-height: 1.65;
  }

  .doc-prose ul li {
    list-style-type: disc;
    color: var(--brand-accent);
  }

  .doc-prose ul li::marker {
    color: var(--brand-accent);
  }

  .doc-prose ol li {
    list-style-type: decimal;
    color: var(--brand-accent);
  }

  .doc-prose ol li::marker {
    color: var(--brand-accent);
    font-weight: 600;
  }

  /* Strong/Bold */
  .doc-prose strong {
    color: var(--text-strong);
    font-weight: 700;
  }

  /* Emphasis */
  .doc-prose em {
    color: var(--text-muted);
    font-style: italic;
  }

  /* Links */
  .doc-prose a {
    color: var(--brand-accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    transition: color 180ms ease, text-decoration-color 180ms ease;
  }

  .doc-prose a:hover {
    color: var(--text-strong);
    text-decoration-color: var(--text-strong);
  }

  /* Blockquotes */
  .doc-prose blockquote {
    margin: var(--space-6) 0;
    padding: var(--space-5) var(--space-6);
    border-left: 4px solid var(--brand-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--brand-accent) 8%, transparent),
      color-mix(in srgb, var(--brand-accent) 3%, transparent)
    );
    font-style: italic;
  }

  .doc-prose blockquote p {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin-bottom: 0;
  }

  /* Code */
  .doc-prose code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0.15em 0.4em;
    border-radius: 0.35em;
    background: color-mix(in srgb, var(--brand-accent) 12%, transparent);
    color: var(--text-strong);
  }

  .doc-prose pre {
    margin: var(--space-5) 0;
    padding: var(--space-5);
    border-radius: var(--radius-md);
    overflow-x: auto;
    background: #1a1525;
    color: #f0eaff;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .doc-prose pre code {
    padding: 0;
    background: none;
    color: inherit;
    font-size: 0.85rem;
  }

  /* Tables */
  .doc-prose table {
    width: 100%;
    margin: var(--space-5) 0;
    border-collapse: separate;
    border-spacing: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--surface-border);
  }

  .doc-prose th {
    padding: var(--space-3) var(--space-4);
    background: color-mix(in srgb, var(--brand-accent) 12%, transparent);
    color: var(--text-strong);
    font-weight: 600;
    text-align: left;
    border-bottom: 2px solid var(--surface-border);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .doc-prose td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--surface-border);
    color: var(--text-body);
  }

  .doc-prose tr:last-child td {
    border-bottom: none;
  }

  .doc-prose tr:hover td {
    background: color-mix(in srgb, var(--brand-accent) 5%, transparent);
  }

  /* Images */
  .doc-prose img {
    border-radius: var(--radius-lg);
    margin: var(--space-5) 0;
    box-shadow: var(--shadow-soft);
  }

  /* Horizontal Rules */
  .doc-prose hr {
    border: none;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--surface-border),
      transparent
    );
    margin: var(--space-7) 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .immersive-doc-panel {
      padding: var(--space-4);
      border-radius: var(--radius-lg);
    }

    .doc-prose {
      font-size: 1rem;
    }

    .doc-prose h1 {
      font-size: 1.75rem;
    }

    .doc-prose h2 {
      font-size: 1.4rem;
      margin-top: var(--space-6);
    }

    .doc-prose h3 {
      font-size: 1.2rem;
    }

    .doc-prose blockquote {
      padding: var(--space-4);
      margin: var(--space-4) 0;
    }

    .doc-prose pre {
      padding: var(--space-4);
      font-size: 0.8rem;
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .immersive-doc-panel {
      transition: none;
    }
  }
</style>
